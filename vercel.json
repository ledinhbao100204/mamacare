{
  "version": 2,
  "name": "mamacare-prj",
  "buildCommand": "npm --prefix FE install --legacy-peer-deps && npm --prefix FE run build",
  "outputDirectory": "FE/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
