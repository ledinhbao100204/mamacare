{
  "version": 2,
  "buildCommand": "cd FE && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "FE/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
