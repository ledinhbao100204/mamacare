                        </button>
                    </div>

                    <div class="p-3 bg-emerald-50/70 rounded-2xl border border-emerald-200 flex items-center justify-between">
                        <div>
                            <h4 class="text-xs font-black font-cute text-slate-800">Tiếng Mưa Rào Pink Noise</h4>
                            <p class="text-[10px] text-slate-500">Âm thanh trắng cắt đứt tạp âm xung quanh</p>
                        </div>
                        <button type="button" onclick="playAudioSynthesizer('Tiếng Mưa Rào Pink Noise', 0, 'pink_noise')" class="px-3 py-1.5 bg-emerald-500 text-white rounded-xl text-xs font-bold bounce-hover">
                            ▶️ Phát Thật
                        </button>
                    </div>
                </div>

                <!-- Live Playing Bar -->
                <div id="audioPlayerBar" class="hidden p-3 bg-slate-900 text-white rounded-2xl flex items-center justify-between text-xs">
                    <div class="flex items-center space-x-2">
                        <span class="animate-spin">💿</span>
                        <span id="currentPlayingTrackName" class="font-bold font-cute">Đang phát nhạc...</span>
                    </div>
                    <button type="button" onclick="stopAudioSynthesizer()" class="px-3 py-1 bg-rose-500 rounded-xl font-bold text-white">
                        Dừng
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODULE 1.4: DIỄN ĐÀN GÓC KHUẤT (SAFE SPACE FORUM) -->
    <!-- ========================================================================= -->
    <div id="momSubSection-forum" class="hidden space-y-6">
        <div class="bg-white rounded-[32px] p-6 sm:p-8 shadow-cloud border-4 border-purple-100 space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-purple-100 pb-4">
                <div>
                    <h3 class="text-lg font-black font-cute text-slate-800">Cộng Đồng Góc Khuất Ẩn Danh 100%</h3>
                    <p class="text-xs text-purple-500 font-bold">Nơi mẹ tâm sự chuyện khó nói nhất mà không sợ bất kỳ ai phán xét</p>
                </div>

                <!-- 3 Phòng Lọc -->
                <div class="flex items-center space-x-2">
                    <select id="forumRoomSelect" onchange="renderForumPosts(this.value)" class="p-2 bg-purple-50 rounded-xl border border-purple-200 text-xs font-black font-cute text-purple-800 outline-none">
                        <option value="all">Tất Cả Các Phòng</option>
                        <option value="rage">🔥 Phòng Xả Giận</option>
                        <option value="advice">💡 Phòng Tìm Lời Khuyên</option>
                        <option value="joy">🌸 Phòng Chia Sẻ Niềm Vui</option>
                    </select>
                </div>
            </div>

            <!-- Form Đăng Bài -->
            <div class="p-4 bg-purple-50/50 rounded-2xl border border-purple-200 space-y-2">
                <textarea id="forumPostText" rows="2" placeholder="Viết tâm sự ẩn danh... Hệ thống sẽ tự cấp biệt danh ngẫu nhiên để bảo vệ bạn tuyệt đối." class="w-full p-3 rounded-xl border border-purple-200 text-xs font-semibold text-slate-700 outline-none resize-none"></textarea>
                <div class="flex justify-end">
                    <button type="button" onclick="createNewPost()" class="px-5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-xl font-black font-cute text-xs shadow-sm bounce-hover">
                        ✨ Đăng Ẩn Danh
                    </button>
                </div>
            </div>

            <!-- Post Lists -->
            <div id="forumPostsList" class="space-y-4">
                <!-- Rendered dynamically -->
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODULE 1.5: NHẮC LỊCH KHÁM & THUỐC (REMINDERS) -->
    <!-- ========================================================================= -->
    <div id="momSubSection-reminders" class="hidden space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Checklist Thuốc -->
            <div class="bg-white rounded-[32px] p-6 sm:p-8 shadow-cloud border-4 border-sky-100 space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-base font-black font-cute text-slate-800">Checklist Uống Thuốc Hôm Nay</h3>
                        <p id="medProgressPercent" class="text-xs text-sky-600 font-black font-cute">50% (2/4 cữ)</p>
                    </div>
                    <button type="button" onclick="addMedicationPrompt()" class="px-3 py-1.5 bg-sky-100 text-sky-700 rounded-xl text-xs font-black font-cute hover:bg-sky-200">
                        + Thêm Thuốc
                    </button>
                </div>

                <!-- Progress Bar -->
                <div class="w-full h-3 bg-slate-100 rounded-full overflow-hidden">
                    <div id="medProgressBar" class="h-full bg-gradient-to-r from-sky-400 to-blue-500 rounded-full med-progress-bar" style="width: 50%;"></div>
                </div>

                <div id="medList" class="space-y-2 pt-2">
                    <!-- Rendered dynamically -->
                </div>
            </div>

            <!-- Lịch Khám Thai -->
            <div class="bg-white rounded-[32px] p-6 sm:p-8 shadow-cloud border-4 border-sky-100 space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-base font-black font-cute text-slate-800">Mốc Khám Thai Định Kỳ</h3>
                    <button type="button" onclick="addAppointmentPrompt()" class="px-3 py-1.5 bg-sky-100 text-sky-700 rounded-xl text-xs font-black font-cute hover:bg-sky-200">
                        + Đặt Lịch
                    </button>
                </div>

                <div id="appointmentList" class="space-y-3 pt-2">
                    <!-- Rendered dynamically -->
                </div>
            </div>
        </div>
    </div>

</section>
