<!-- MODAL VIDEO DADDY BOOTCAMP & QUIZ LÀM BA -->
<div id="bootcampModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-md hidden p-4">
    <div class="bg-white rounded-[36px] max-w-lg w-full p-6 sm:p-8 shadow-2xl border-4 border-amber-200 space-y-5">
        <div class="flex items-center justify-between">
            <span id="bootcampBadge" class="text-[10px] font-black uppercase font-cute px-3 py-1 bg-amber-100 text-amber-800 rounded-full border border-amber-200">
                Micro-learning < 1 phút
            </span>
            <button type="button" onclick="closeBootcampModal()" class="text-slate-400 hover:text-slate-700 text-xl font-bold">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="space-y-1">
            <h3 id="bootcampVideoTitle" class="text-lg font-black font-cute text-slate-800">Giải Mã Hormone Estrogen & Progesterone</h3>
            <p id="bootcampVideoDesc" class="text-xs text-slate-500 font-semibold">Thời lượng: 0:45 min • Bí quyết để vợ không tủi thân</p>
        </div>

        <!-- Video Player Simulator -->
        <div class="w-full aspect-video bg-slate-900 rounded-3xl relative overflow-hidden flex items-center justify-center border-2 border-slate-800 shadow-inner group">
            <div class="absolute inset-0 bg-gradient-to-tr from-amber-500/20 to-rose-500/20"></div>
            <div class="text-center relative z-10 space-y-2">
                <div class="w-14 h-14 rounded-full bg-white/90 text-amber-600 flex items-center justify-center text-xl mx-auto shadow-lg group-hover:scale-110 transition cursor-pointer">
                    <i class="fa-solid fa-play ml-1"></i>
                </div>
                <p class="text-white text-xs font-bold font-cute">Bấm để xem video cô đọng 45 giây</p>
            </div>
        </div>

        <!-- Mini-Quiz -->
        <div class="p-4 bg-amber-50 rounded-2xl border border-amber-200 space-y-3">
            <p id="bootcampQuizQuestion" class="text-xs font-black font-cute text-slate-800">Khi vợ đột ngột tủi thân khóc, câu nói nào thể hiện bố 10 điểm?</p>
            <div class="grid grid-cols-1 gap-2 text-xs">
                <button type="button" onclick="answerBootcampQuiz(false)" class="p-2.5 bg-white rounded-xl border border-slate-200 text-left font-semibold text-slate-700 hover:border-amber-400 transition">
                    A. 'Có mỗi việc ở nhà cũng khóc, em nhạy cảm quá rồi đấy!'
                </button>
                <button type="button" onclick="answerBootcampQuiz(true)" class="p-2.5 bg-white rounded-xl border border-slate-200 text-left font-semibold text-slate-700 hover:border-emerald-400 transition">
                    B. 'Anh ở đây rồi, vợ vất vả nhiều rồi, để anh ôm vợ một chút nhé!'
                </button>
            </div>
            <p id="bootcampQuizResult" class="hidden text-xs font-black font-cute text-emerald-600"></p>
        </div>
    </div>
</div>
